# Godot cache (the .import files next to assets ARE committed)
game/.godot/
*.tmp

# Harness and review outputs (regenerated by tools/)
harness/out/
harness/snap/
review/inbox/
review/archive/raw/
review/archive/builds/
review/archive/qa/
*.avi
builds/

# Python
__pycache__/
*.pyc
.venv/

# Secrets: never commit keys
.env
.env.*
!.env.example

# Claude local data
.claude/data/
.claude/settings.local.json
