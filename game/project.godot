; Engine configuration file for Inner Sun.
; Godot may reformat this file when settings change. Explanations live in docs/DECISIONS.md.

config_version=5

[application]

config/name="Inner Sun"
config/description="FTL-style roguelite: a drill ship boring down into a hollow Earth."
config/version="0.0.1-m0"
run/main_scene="res://view/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="InnerSun"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
run/flush_stdout_on_print=true

[autoload]

Boot="*res://view/boot.gd"

[debug]

settings/gdscript/always_track_call_stacks=true
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/no_focus=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver.windows="vulkan"
rendering_device/fallback_to_d3d12=false
viewport/hdr_2d=true
environment/defaults/default_clear_color=Color(0.015, 0.014, 0.018, 1)
